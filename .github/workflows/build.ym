name: Build APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v6
        with:
          node-version: 24
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: 21

      - name: Install dependencies
        run: npm install

      - name: Arrange web files
        run: |
          mkdir -p www/libs www/fonts
          cp index.html www/
          cp node_modules/pdfjs-dist/build/pdf.min.mjs www/libs/pdf.min.js
          cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs www/libs/pdf.worker.min.js
          cp node_modules/mammoth/mammoth.browser.min.js www/libs/
          cp node_modules/xlsx/dist/xlsx.full.min.js www/libs/
          cp node_modules/pdf-lib/dist/pdf-lib.min.js www/libs/
          cp node_modules/@highlightjs/cdn-assets/highlight.min.js www/libs/
          cp node_modules/@highlightjs/cdn-assets/styles/github-dark.min.css www/libs/
          cp node_modules/@fontsource/noto-sans-bengali/files/noto-sans-bengali-bengali-400-normal.woff2 www/fonts/
          cp node_modules/@fontsource/noto-sans-bengali/files/noto-sans-bengali-latin-400-normal.woff2 www/fonts/

      - name: Add Android platform
        run: npx cap add android

      - name: Enable "Open with" for files
        run: |
          D=android/app/src/main/java/com/mehedi/dekho
          mkdir -p $D && cp MainActivity.java $D/MainActivity.java
          python3 - <<'PY'
          p='android/app/src/main/AndroidManifest.xml'
          s=open(p).read()
          mimes=['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','application/vnd.ms-excel','application/json','application/xml','application/javascript','text/*','image/*']
          f='<intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><data android:scheme="content"/><data android:scheme="file"/>'+''.join('<data android:mimeType="%s"/>'%m for m in mimes)+'</intent-filter>'
          s=s.replace('</activity>',f+'</activity>',1)
          open(p,'w').write(s)
          PY

      - name: Sync and build
        run: |
          npx cap sync android
          cd android && ./gradlew assembleDebug

      - uses: actions/upload-artifact@v7
        with:
          name: Dekho-APK
          path: android/app/build/outputs/apk/debug/*.apk
